{
  // Run any of these with: Terminal > Run Task...  (or Ctrl+Shift+P > "Tasks: Run Task")
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Demo: command-line tool",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/demo.ps1"],
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Web app: open in browser",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-Command",
        "Start-Process 'http://localhost:4173'; python '${workspaceFolder}/scripts/serve.py' 4173"
      ],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Run all tests",
      "type": "shell",
      "command": "cargo test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Rebuild web app (WebAssembly)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build-web.ps1"],
      "problemMatcher": ["$rustc"]
    }
  ]
}
